# Settings names only, never values. Real values go in the Vercel dashboard
# (or a git-ignored .env.local), added by a person.

# Build flag: 1 shows phase 2 (PIN lock, sync, the DOH view). Unset: the
# offline core only.
VITE_PHASE2=

# Phase 2 sync backend (api/, server/). Vercel's Neon integration sets
# DATABASE_URL. Without one of these, the routes that need it answer 503.
DATABASE_URL=
MUNICIPAL_ENROLL_CODE=
DOH_VIEW_CODE=
